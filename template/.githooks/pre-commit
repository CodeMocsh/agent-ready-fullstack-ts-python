#!/bin/sh
# Lint both halves, then check them against each other.
#
# Each step is skipped when its toolchain is absent rather than failing the commit,
# so a clone that has installed only one half still commits. That makes this a fast
# signal and not a gate: CI runs all three checks unconditionally, including the
# contract suite, and is what actually enforces them.
set -eu

cd "$(git rev-parse --show-toplevel)"
failed=0
has_frontend=0
has_backend=0

if command -v pnpm >/dev/null 2>&1 && [ -d frontend/node_modules ]; then
    has_frontend=1
    pnpm -C frontend lint:check || failed=1
else
    echo "pre-commit: skipping frontend checks (run 'make install' to enable them)"
fi

if command -v uv >/dev/null 2>&1 && [ -d backend/.venv ]; then
    has_backend=1
    (cd backend && uv run --no-sync python devtools/lint.py --check) || failed=1
else
    echo "pre-commit: skipping backend checks (run 'make install' to enable them)"
fi

if [ "$has_frontend" = "1" ] && [ "$has_backend" = "1" ]; then
    sh devtools/contract-test.sh || failed=1
else
    echo "pre-commit: skipping the contract suite (it needs both halves installed)"
fi

exit "$failed"
