#!/bin/sh
# The gate, before the commit rather than after the push. `make pre-commit` is the
# list of checks; this script decides only whether this clone can run it.
#
# A half that is not installed is skipped rather than failing the commit, because a
# clone that has installed only one of them is a legitimate way to work here. That
# is also the one dangerous thing in this file: a run where everything skipped exits
# 0 and looks exactly like a run where everything passed. So a partial run says what
# it did not do, on stderr, every time. No workflow runs the list afterwards, so this
# script and `make pre-commit` on your own machine are the whole of the enforcement.
set -eu

cd "$(git rev-parse --show-toplevel)"

has_frontend=0
has_backend=0
if command -v pnpm >/dev/null 2>&1 && [ -d frontend/node_modules ]; then
    has_frontend=1
fi
if command -v uv >/dev/null 2>&1 && [ -d backend/.venv ]; then
    has_backend=1
fi

if [ "$has_frontend" = 1 ] && [ "$has_backend" = 1 ]; then
    exec make -s pre-commit
fi

# Below here the gate cannot run as one, because two of its four members -- the
# contract suite and the artifact check -- are about the two halves agreeing and
# have nothing to compare against. What is left runs directly.
failed=0

if [ "$has_frontend" = 1 ]; then
    pnpm -C frontend lint:check || failed=1
    pnpm -C frontend test || failed=1
fi

if [ "$has_backend" = 1 ]; then
    (cd backend && uv run --no-sync python devtools/lint.py --check) || failed=1
    (cd backend && uv run --no-sync pytest -q) || failed=1
fi

echo "" >&2
echo "pre-commit: PARTIAL RUN -- this commit was not checked by the whole gate." >&2
[ "$has_frontend" = 1 ] || echo "  frontend        SKIPPED (no pnpm, or run 'make install')" >&2
[ "$has_backend" = 1 ] || echo "  backend         SKIPPED (no uv, or run 'make install')" >&2
echo "  openapi-check   SKIPPED (needs both halves)" >&2
echo "  contract suite  SKIPPED (needs both halves)" >&2
echo "Run 'make install', then 'make pre-commit', to check it properly." >&2

exit "$failed"
