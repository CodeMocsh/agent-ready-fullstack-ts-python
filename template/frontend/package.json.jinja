{%- macro q(value) -%}
{#- Every answer below is free-form text landing in hand-written JSON, so a quote or
    a backslash in one would produce a file no tool can parse. `tojson` emits the
    whole literal, quotes included; the replaces undo its HTML-safety escaping of
    & < > ', which is valid JSON but unreadable in a file a person opens. -#}
{{ value | tojson | replace('\\u0027', "'") | replace('\\u0026', '&') | replace('\\u003c', '<') | replace('\\u003e', '>') }}
{%- endmacro -%}
{
  "name": {{ q(package_name) }},
  "version": "0.0.0",
  "description": {{ q(package_description) }},
  "license": {{ q(package_license_spdx) }},
  "private": true,
  "author": {
    "name": {{ q(package_author_name) }},
    "email": {{ q(package_author_email) }}
  },
  "repository": {
    "type": "git",
    "url": {{ q("git+https://github.com/" ~ package_github_org ~ "/" ~ package_name ~ ".git") }}
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "complexity": {
    "cap": 15,
    "tolerance": 0.02,
    "ceilingFactor": 1.25,
    "exclude": [
      "src/components/ui/**",
      "src/lib/utils.ts",
      "src/api/schema.ts"
    ]
  },
  "conformance": {
    "themeFiles": [
      "src/index.css"
    ],
    "allow": [],
    "exclude": [
      "src/components/ui/**",
      "src/lib/utils.ts",
      "src/api/schema.ts"
    ]
  },
  "scripts": {
    "prepare": "sh ../devtools/install-hooks.sh",
    "dev": "vite",
    "dev:live": "vite --mode live",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "openapi:types": "pnpm dlx openapi-typescript@7.13.0 ../openapi.json -o src/api/schema.ts",
    "lint": "biome check --write src tests e2e devtools && tsc --noEmit && pnpm run conformance && pnpm run complexity",
    "lint:check": "biome ci src tests e2e devtools && tsc --noEmit && pnpm run conformance && pnpm run complexity",
    "conformance": "node devtools/conformance.mjs src",
    "complexity": "node devtools/complexity.mjs src --baseline .complexity-baseline.json",
    "complexity:baseline": "pnpm run complexity --update-baseline",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "msw": "^2.15.0",
    "openapi-msw": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "shadcn": "^4.16.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
