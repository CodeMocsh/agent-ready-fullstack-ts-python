      "delete": {
        "summary": "Delete Task",
        "operationId": "delete_task_tasks__id__delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "500": {
            "description": "Response exceeds its byte limit, or response did not finish within its time limit",
