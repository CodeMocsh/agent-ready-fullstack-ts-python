  },
  "components": {
    "schemas": {
      "AnsweredPart": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "answered",
            "title": "Kind"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Headers"
          },
          "body": {
            "type": "string",
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "status",
          "headers",
          "body"
        ],
        "title": "AnsweredPart"
      },
      "ClientEvent": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "uncaught",
              "caught",
              "query",
              "mutation",
              "build"
            ],
            "title": "Kind"
          },
          "route": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_$./-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "error": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "title": "Error"
          },
          "status": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 599.0,
                "minimum": 100.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "route",
          "error",
          "status",
          "request_id"
        ],
        "title": "ClientEvent",
        "description": "One failure the browser saw, named rather than described. No field takes free text:\nthe route is the router's template and the error is its class name."
      },
      "ClientEvents": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/ClientEvent"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "events"
        ],
        "title": "ClientEvents"
      },
      "CreateTaskBody": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 500,
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CreateTaskBody"
      },
      "ErrorBody": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "dead"
            ],
            "title": "State"
          },
          "outcome": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "outcome",
          "failure"
        ],
        "title": "Job",
        "description": "One job, as the tenant that asked for it reads it. `outcome` is set when the job is `done`,\nand `failure` names why it is `dead`."
      },
      "JsonValue": {},
      "LeftPart": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "left",
            "title": "Kind"
          },
          "reason": {
            "type": "string",
            "enum": [
              "timed out",
              "not a part",
              "past the cap",
              "too large"
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "reason"
        ],
        "title": "LeftPart"
      },
      "Reads": {
        "properties": {
          "parts": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/AnsweredPart"
                },
                {
                  "$ref": "#/components/schemas/LeftPart"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "answered": "#/components/schemas/AnsweredPart",
                  "left": "#/components/schemas/LeftPart"
                }
              }
            },
            "type": "array",
            "title": "Parts"
          }
        },
        "type": "object",
        "required": [
          "parts"
        ],
        "title": "Reads"
      },
      "Task": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "done"
        ],
        "title": "Task"
      },
      "TaskPage": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Tasks"
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next"
          }
        },
        "type": "object",
        "required": [
          "tasks",
          "next"
        ],
        "title": "TaskPage"
      },
      "UpdateTaskBody": {
        "properties": {
          "done": {
            "type": "boolean",
            "title": "Done"
          }
        },
        "type": "object",
        "required": [
          "done"
        ],
        "title": "UpdateTaskBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
